---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublishedBlogPosts } from '../../lib/blog';
import {
	buildBreadcrumbJsonLd,
	buildCollectionPageJsonLd,
	summarizeText,
} from '../../lib/seo';

const posts = await getPublishedBlogPosts();
const pageTitle = `Blog | ${SITE_TITLE}`;
const pageDescription = summarizeText(
	"Technical writing, development notes, and production breakdowns from Andy Zou on game dev, web engineering, creative tools, and whatever he's working on.",
);
const jsonLd = Astro.site
	? [
			buildCollectionPageJsonLd(Astro.site, {
				title: "Andy Zou Blog",
				description: pageDescription,
				path: "/blog/",
			}),
			buildBreadcrumbJsonLd(Astro.site, [
				{ name: "Home", path: "/" },
				{ name: "Blog", path: "/blog/" },
			]),
		]
	: [];
---

<!doctype html>
	<html lang="en">
		<head>
			<BaseHead title={pageTitle} description={pageDescription} jsonLd={jsonLd} />
			<style>
			main {
				box-sizing: border-box;
				width: 1280px;
				max-width: 100%;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
				justify-content: center;
			}
			ul li {
				width: calc(33% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				aspect-ratio: 16/9;
				object-fit:contain;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--gray));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
							posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<img
											width={720}
											height={360}
											src={post.data.heroImage}
											alt={post.data.heroImageAlt}
										/>
										<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
