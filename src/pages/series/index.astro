---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
import { getSeries, getVideosBySeries } from "../../lib/work";

const seriesList = getSeries();
const pageTitle = `Series | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description="Browse all video series." />
  </head>
  <body>
    <main>
      <p><a href="/">Back to home</a></p>
      <h1>Series</h1>

      <div class="grid">
        {seriesList.map((series) => (
          <a class="card" href={`/series/${series.slug}/`}>
            <h2>{series.title}</h2>
            <p>{series.description}</p>
            <p>{getVideosBySeries(series.id).length} videos</p>
          </a>
        ))}
      </div>
      <Footer />
    </main>

    <style>
      main {
        max-width: 980px;
        margin: 0 auto;
        padding: 1rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 14px;
      }

      .card {
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        padding: 1rem;
        text-decoration: none;
        color: inherit;
      }

      .card h2 {
        margin: 0;
      }

      .card p {
        margin-top: 0.5rem;
      }
    </style>
  </body>
</html>
