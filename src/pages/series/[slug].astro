---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import VideoLightbox from "../../components/VideoLightbox.astro";
import WorkTilesBySeries from "../../components/WorkTilesBySeries.astro";
import { SITE_TITLE } from "../../consts";
import {
  getSeriesIds,
  getSeriesTitle,
  getVideosBySeries,
  hasSeries,
} from "../../lib/work";
import Titleheader from "../../components/Header.astro";

export async function getStaticPaths() {
  return getSeriesIds().map((seriesId) => ({
    params: { slug: seriesId },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing series slug.");
}

if (!hasSeries(slug)) {
  throw new Error(`Unknown series slug: ${slug}`);
}

const seriesId = slug;
const seriesTitle = getSeriesTitle(seriesId);
const videos = getVideosBySeries(seriesId);
const pageTitle = `${seriesTitle} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={`${seriesTitle} video series`} />
  </head>
  <body>
    <Titleheader />

    <main class="text-center">
      <p><a href="/">Back to home</a></p>
      <h2>{seriesTitle}</h2>

      <div class="tiles">
        <WorkTilesBySeries seriesId={seriesId} />
      </div>
      <VideoLightbox tileSelector=".tiles .tile[data-lightboxable='true']" />
      <Footer />
    </main>

    <style>
      main {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem;
      }

      .tiles {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        padding-top: 12px;
      }
    </style>
  </body>
</html>
