---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import VideoLightbox from "../../components/VideoLightbox.astro";
import WorkTilesBySeries from "../../components/WorkTilesBySeries.astro";
import { SITE_TITLE } from "../../consts";
import {
  getSeriesIds,
  getSeriesMeta,
  getSeriesTitle,
  hasSeries,
} from "../../lib/work";
import Titleheader from "../../components/Header.astro";

export async function getStaticPaths() {
  return getSeriesIds().map((seriesId) => ({
    params: { slug: seriesId },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing series slug.");
}

if (!hasSeries(slug)) {
  throw new Error(`Unknown series slug: ${slug}`);
}

const seriesId = slug;
const seriesMeta = getSeriesMeta(seriesId);
const seriesTitle = getSeriesTitle(seriesId);
const seriesCopy = seriesMeta?.copy;
const pageTitle = `${seriesTitle} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={pageTitle}
      description={seriesCopy ?? `${seriesTitle} video series`}
    />
  </head>
  <body>
    <main class="text-left">
      <Titleheader />
      <div class="header-container">
        <a href="/" class="backlink z-10" data-series-back-link>Back Home</a>
        <h2 class="bigtitle">{seriesTitle}</h2>
        {seriesCopy && <p class="series-copy">{seriesCopy}</p>}
      </div>

      <div class="tilescontainer">
        <WorkTilesBySeries seriesId={seriesId} />
      </div>
      <VideoLightbox tileSelector=".tiles .tile[data-lightboxable='true']" />
      <Footer />
    </main>
    <script>
      import { initSeriesBackLink } from "../../scripts/seriesBackLink";

      initSeriesBackLink();
    </script>
  </body>
</html>

<style>
  .backlink {
    font-size: 2em;
    color: white;
    cursor: pointer;
  }

  .bigtitle {
    border-bottom: 0.5cqw solid white;
  }
  .backlink:hover {
    text-decoration: underline;
  }

  .header-container {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .header-container h2 {
    margin: 0;
  }

  .series-copy {
    margin: 0;
    font-size: 3rem;
    line-height: 1.3;
  }

  .tilescontainer {
    padding: 0;
  }
</style>
