---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import VideoLightbox from "../../components/VideoLightbox.astro";
import WorkTilesBySeries from "../../components/WorkTilesBySeries.astro";
import { SITE_TITLE } from "../../consts";
import {
  getSeriesTiles,
  getSeriesHomeHref,
  getSeriesPageIds,
  getSeriesMeta,
  getSeriesTitle,
  hasSeries,
} from "../../lib/work";
import Titleheader from "../../components/Header.astro";
import {
  buildBreadcrumbJsonLd,
  buildCollectionPageJsonLd,
  summarizeText,
} from "../../lib/seo";

export async function getStaticPaths() {
  return getSeriesPageIds().map((seriesId) => ({
    params: { slug: seriesId },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing series slug.");
}

if (!hasSeries(slug)) {
  throw new Error(`Unknown series slug: ${slug}`);
}

const seriesId = slug;
const seriesMeta = getSeriesMeta(seriesId);
const seriesTitle = getSeriesTitle(seriesId);
const seriesCopy = seriesMeta?.copy;
const homeHref = getSeriesHomeHref(seriesId);
const pageTitle = `${seriesTitle} | ${SITE_TITLE}`;
const pageDescription = summarizeText(
  seriesCopy ?? `${seriesTitle} video series directed by Andy Zou.`,
);
const seriesImage = getSeriesTiles(seriesId)[0]?.media;
const socialImage = seriesImage?.kind === "image" ? seriesImage.src : seriesImage?.poster;
const socialImageAlt =
  seriesImage?.kind === "image"
    ? seriesImage.alt
    : `${seriesTitle} series thumbnail`;
const jsonLd = Astro.site
  ? [
      buildCollectionPageJsonLd(Astro.site, {
        title: seriesTitle,
        description: pageDescription,
        path: `/series/${seriesId}/`,
      }),
      buildBreadcrumbJsonLd(Astro.site, [
        { name: "Home", path: "/" },
        { name: seriesTitle, path: `/series/${seriesId}/` },
      ]),
    ]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      image={socialImage}
      imageAlt={socialImageAlt}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <Titleheader />
    <main>
      <a href={homeHref} class="backlink my-4 block text-center hover:underline"
        >&larr; Back Home</a
      >
      <h2 class="text-center font-bold my-2">{seriesTitle}</h2>
      {seriesCopy && <p class="copy max-w-7xl w-fit mx-auto">{seriesCopy}</p>}

      <div class="tilescontainer">
        <WorkTilesBySeries seriesId={seriesId} />
      </div>
      <VideoLightbox />
      <Footer />
    </main>
  </body>
</html>
