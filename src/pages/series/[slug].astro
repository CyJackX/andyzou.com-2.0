---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import VideoLightbox from "../../components/VideoLightbox.astro";
import WorkTilesBySeries from "../../components/WorkTilesBySeries.astro";
import { SITE_TITLE } from "../../consts";
import {
  getSeriesIds,
  getSeriesMeta,
  getSeriesTitle,
  hasSeries,
} from "../../lib/work";
import Titleheader from "../../components/Header.astro";

export async function getStaticPaths() {
  return getSeriesIds().map((seriesId) => ({
    params: { slug: seriesId },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing series slug.");
}

if (!hasSeries(slug)) {
  throw new Error(`Unknown series slug: ${slug}`);
}

const seriesId = slug;
const seriesMeta = getSeriesMeta(seriesId);
const seriesTitle = getSeriesTitle(seriesId);
const seriesCopy = seriesMeta?.copy;
const pageTitle = `${seriesTitle} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={pageTitle}
      description={seriesCopy ?? `${seriesTitle} video series`}
    />
  </head>
  <body>
    <main>
      <Titleheader />
      <a href="/" class="backlink my-4 block text-left" data-series-back-link>← Back Home</a>
      <h2 class="text-center font-bold my-2">{seriesTitle}</h2>
      {seriesCopy && <p class="copy max-w-7xl">{seriesCopy}</p>}

      <div class="tilescontainer">
        <WorkTilesBySeries seriesId={seriesId} />
      </div>
      <VideoLightbox />
      <Footer />
    </main>
    <script>
      import { initSeriesBackLink } from "../../scripts/seriesBackLink";

      initSeriesBackLink();
    </script>
  </body>
</html>
