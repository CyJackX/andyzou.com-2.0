---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import VideoLightbox from "../../components/VideoLightbox.astro";
import WorkTile from "../../components/WorkTile.astro";
import { SITE_TITLE } from "../../consts";
import { getSeries, getSeriesBySlug, getVideosBySeries } from "../../lib/work";

export async function getStaticPaths() {
  return getSeries().map((series) => ({
    params: { slug: series.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error("Missing series slug.");
}

const series = getSeriesBySlug(slug);
if (!series) {
  throw new Error(`Unknown series slug: ${slug}`);
}

const videos = getVideosBySeries(series.id);
const pageTitle = `${series.title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={series.description} />
  </head>
  <body>
    <main>
      <p><a href="/">Back to home</a></p>
      <h1>{series.title}</h1>
      <p>{series.description}</p>
      <p>{videos.length} video{videos.length === 1 ? "" : "s"}</p>

      <div class="tiles">
        {videos.map((video) => {
          const tileHref = video.sourceHref ?? video.href ?? `/video/${video.slug}/`;
          return (
            <WorkTile
              id={video.id}
              type="video"
              title={video.title}
              subtitle={video.subtitle}
              roles={video.roles}
              copy={video.copy}
              media={video.media}
              href={tileHref}
              lightboxable={tileHref.startsWith("http")}
              vertical={video.vertical === true}
              ariaLabel={`${video.title} details`}
            />
          );
        })}
      </div>
      <VideoLightbox tileSelector=".tiles .tile[data-lightboxable='true']" />
      <Footer />
    </main>

    <style>
      main {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem;
      }

      .tiles {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        padding-top: 12px;
      }
    </style>
  </body>
</html>
