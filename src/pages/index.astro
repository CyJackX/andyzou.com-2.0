---
import AccordionItem from "../components/AccordionItem.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import WorkTilesBySeries from "../components/WorkTilesBySeries.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import CaseCard from "../components/CaseCard.astro";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import pissterine from "../images/pissterine.jpg";
import tootsies from "../images/tootsies_06.06.25-04326-Enhanced-NR.jpg";
import Image from "astro/components/Image.astro";
import Titleheader from "../components/Header.astro";
import WorkTileByID from "../components/WorkTileByID.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Titleheader />
    <main class="text-center">
      <VideoLightbox
        tileSelector=".tile[data-lightboxable='true'], .hero-tile[data-lightboxable='true']"
      />
      <AccordionItem title="Director">
        <div id="tilescontainer" class="tilescontainer">
          <WorkTileByID id="directing-reel" />
          <h2 class="section-title">Scripted Digital Series</h2>
          <WorkTilesBySeries seriesId="series" className="tile-series" />
          <h2 class="section-title">Branded Content</h2>
          <WorkTilesBySeries
            seriesId="branded-content"
            className="tile-series"
          />
          <h2 class="section-title">Comedy Music Videos</h2>
          <WorkTilesBySeries seriesId="music-videos" className="tile-series" />
          <h2 class="section-title">Short Films</h2>
          <WorkTilesBySeries seriesId="shorts" className="tile-series" />
          <h2 class="section-title">Timeless Fan Favorites</h2>
          <WorkTilebyId id="tuber" className="tile-series" />
          <WorkTilebyId id="andys-roadshow" className="tile-series" />
          <WorkTilebyId
            id="pissterine"
            className="tile-series"
            target="_blank"
          />
          <h2 class="section-title">Sketch Comedy</h2>
          <WorkTilesBySeries seriesId="sketch" className="tile-series" />
        </div>
      </AccordionItem>
      <AccordionItem title="Technologist" />
      <p>Andy is no stranger to technology from 3d to genAI, he loves to tinker.</p>
      <div id="tilescontainer" class="tilescontainer">
        <WorkTilesBySeries seriesId="tech" className="tile-series" />
      </div>
      <AccordionItem title="Weirdo">
        <div class="flex items-start justify-center mt-8">
          <div class="grow shrink basis-[360px]">
            <Image
              src={azaleaShoot}
              width="1280"
              height="720"
              alt="Making It"
              class="aspect-video object-cover w-full object-top rounded-lg"
              loading="lazy"
            />
            <p class="px-8 m-8">
              Andy lives in Brooklyn with his wife and collaborator Katie
              Sicking and their daughter Azalea.
            </p>
          </div>
          <div class="grow shrink basis-[360px]">
            <WorkTilebyId id="tootsies" target="_blank" /><p class="px-8 m-8">
              He's also a co-producer on annual short film festival Tootsie's
              Video Vault.
            </p>
          </div>
        </div>
      </AccordionItem>
    </main>

    <Footer />

    <style>
      .section-title {
        width: 100%;
        margin-top: 0.5em;
        text-align: left;
        border-bottom: 2px solid white;
      }

      main {
        padding: 1em;
        max-width: 1280px;
        margin: 0 auto;
      }

      .tilescontainer {
        display: flex;
        flex-wrap: wrap;
        justify-content: left;
        align-items: center;
        gap: 16px;
      }

      :global(.tile[data-id="directing-reel"]) {
        flex: 1 1 360px;
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
      }
    </style>
  </body>
</html>
