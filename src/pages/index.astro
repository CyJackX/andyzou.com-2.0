---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import WorkTilesBySeries from "../components/WorkTilesBySeries.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

function formatGalleryAlt(filePath: string) {
  const filename =
    filePath
      .split("/")
      .pop()
      ?.replace(/\.[^.]+$/, "") ?? "Andy photo";

  return filename.replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();
}

const andyGalleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../images/andy/*.{jpg,jpeg,png,webp,avif}",
    { eager: true },
  ),
)
  .map(([filePath, module]) => ({
    alt: formatGalleryAlt(filePath),
    src: module.default,
  }))
  .sort((a, b) =>
    a.alt.localeCompare(b.alt, undefined, {
      numeric: true,
      sensitivity: "base",
    }),
  );
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="text-center">
      <VideoLightbox tileSelector="[data-lightboxable='true']" />
      <!-- <ol class="tilescontainer">
        <WorkTileByID id="directing-reel" />
      </div> -->
      <Header />
      <details name="top-level" open>
        <summary><h2 class="section-title bigtitle">Director</h2></summary>
        <div>
          <details name="director-subsection">
            <summary
              ><h2 class="section-title subsection">
                Scripted Digital Series
              </h2></summary
            >
            <ol class="tilescontainer">
              <WorkTilesBySeries seriesId="series" />
            </ol>
          </details>

          <details name="director-subsection">
            <summary
              ><h2 class="section-title subsection">
                Branded Content
              </h2></summary
            >
            <ol class="tilescontainer two-col">
              <WorkTilesBySeries seriesId="branded-content" />
            </ol>
          </details>

          <details name="director-subsection">
            <summary
              ><h2 class="section-title subsection">
                Sketches & Shorts
              </h2></summary
            >
            <ol class="tilescontainer">
              <WorkTilesBySeries seriesId="sketch" />
              <WorkTilesBySeries seriesId="shorts" />
            </ol>
          </details>
          <details name="director-subsection">
            <summary
              ><h2 class="section-title subsection">Music Videos</h2></summary
            >
            <ol class="tilescontainer">
              <WorkTilesBySeries seriesId="music-videos" />
            </ol>
          </details>
          <details name="director-subsection">
            <summary
              ><h2 class="section-title subsection">
                Fan Favorites
              </h2></summary
            ><ol class="tilescontainer">
              <li><WorkTilebyId id="tuber" /></li>
              <li>
                <WorkTilebyId id="andys-roadshow" />
              </li>
              <li>
                <WorkTilebyId id="pissterine" target="_blank" />
              </li>
            </ol>
          </details>
        </div>
      </details>
      <!-- <details name="top-level">
        <summary><h2 class="section-title bigtitle">Creative</h2></summary><ol
          class="tilescontainer"
        >
          <li>Polygon</li>
          <li>Escadating</li>
          <li>Immersive?</li>
        </ol>
      </details> -->

      <details name="top-level">
        <summary><h2 class="section-title bigtitle">Technologist</h2></summary>
        <p class="copy">
          From After Effects compositing to VR, 3D engines, genAI, webdev, and
          more, Andy has a wide range of technical skills that support his work
          as a director and an editor. He blogs occasionally about his projects
          at <a
            href="https://medium.com/@andyzou"
            target="_blank"
            class="underline">https://medium.com/@andyzou</a
          >
        </p>
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="tech" />
        </ol>
      </details>
      <!-- 
      <details name="top-level">
        <summary
          ><h2 class="section-title bigtitle">Unscripted Editor</h2></summary
        >
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="editing"  />
        </ol>
      </details> -->

      <details name="top-level">
        <summary><h2 class="section-title bigtitle">Weirdo</h2></summary>
        <p class="copy">
          With a background in Experimental Theatre & Computer Science, Andy has
          been hands-on as a director throughout his career. From creative
          writing to line producing, cinematography to editing, Andy's holistic
          experience in content creation gives him the skills to smoothly take
          projects from script to screen. As a director, Andy focuses on the
          audience experience to find the relatability in everything he makes,
          utilizing pop culture and modern trends.
        </p>
        <p>
          Time spent as a scrappy one-man band enables him to scale to managing
          larger productions, etc, in ways that people typically can't manage
        </p>
        <ol class="flex flex-wrap gap-8 items-start justify-center my-8">
          {
            andyGalleryImages.map((image) => (
              <li>
                <a
                  href={image.src.src}
                  class="gallery-lightbox"
                  data-lightboxable="true"
                  data-title={image.alt}
                  aria-label={`${image.alt} full image`}
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    height="640"
                    loading="lazy"
                    class="h-60 w-auto md:h-85 block"
                  />
                </a>
              </li>
            ))
          }
          <li class="max-w-4xl">
            <a
              href={azaleaShoot.src}
              class="gallery-lightbox"
              data-lightboxable="true"
              data-title="Bug Family"
              aria-label={`Family Bugs full image`}
            >
              <Image
                src={azaleaShoot}
                alt="Bug Family"
                height="640"
                loading="lazy"
                class="aspect-video object-cover"
              />
            </a>
            <p class="px-8 m-8">
              Andy lives in Brooklyn with his wife and collaborator Katie
              Sicking and their daughter Azalea.
            </p>
          </li>
          <li>
            <div>
            <WorkTilebyId id="tootsies" target="_blank" className="max-w-[560px] w-full mx-auto"/>
            </div>
            <p class="px-8 m-8">
              He's also a co-producer on annual short film festival <a
                class="text-nowrap"
                href="https://www.tootsiesvideovault.com"
                target="_blank"
              >
                Tootsie's Video Vault!</a
              >
            </p>
          </li>
        </ol>
      </details>
    </main>
    <script>
      import { initIndexPage } from "../scripts/indexPage";

      initIndexPage();
    </script>
  </body><Footer />

  <style>
    :root {
      interpolate-size: allow-keywords;
    }

    details {
      position: relative;
      overflow: hidden;
    }

    details::after {
      position: absolute;
      content: "";
      inset: 0;
      pointer-events: none;
      border-bottom: 0.5cqw solid white;
    }

    details::details-content {
      block-size: 0;
      transition:
        block-size 0.5s,
        content-visibility 0.5s;
      transition-behavior: allow-discrete;
    }

    details:open::details-content {
      block-size: auto;
    }

    summary {
      list-style: none;
    }

    .section-title:hover {
      background-color: white;
      color: black;
    }

    .section-title:hover .header-video {
      display: none;
    }

    .subsection {
      /* width: fit-content; */
      /* margin: 0 auto; */
    }

    @media (max-width: 768px) {
      .subsection {
        font-size: 1.75em;
      }
    }

    .gallery-lightbox {
      display: block;
      border-radius: 12px;
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .tilescontainer.two-col {
        grid-template-columns: repeat(2, minmax(320px, 1fr));
      }
    }
  </style>
</html>
