---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { CASES } from "../data/cases";

const allTags = [...new Set(CASES.flatMap((entry) => entry.tags))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class ="text-center">
      <h1 class="title">Andy Zou</h1>
      <h2>Video Director & Creative Technologist</h2>

      <div class="filters" aria-label="Case filters">
        <fieldset>
          <legend>Filter by tag</legend>
          <div class="tagList">
            {allTags.map((tag) => (
              <label>
                <input type="checkbox" name="tag" value={tag} />
                {tag}
              </label>
            ))}
          </div>
        </fieldset>

      </div>

      <div id="caseRow" class="caseRow"></div>

      <script
        type="application/json"
        id="__cases"
        set:html={JSON.stringify(CASES)}
      ></script>

      <script type="module">
        const casesEl = document.getElementById("__cases");
        const caseRow = document.getElementById("caseRow");
        const checkboxes = Array.from(document.querySelectorAll('input[name="tag"]'));

        const cases = JSON.parse(casesEl?.textContent || "[]");
        const state = {
          selectedTags: new Set(),
        };

        function intersectsTags(caseItem, selectedTags) {
          if (selectedTags.size === 0) return true;
          return caseItem.tags.some((tag) => selectedTags.has(tag));
        }

        function renderTile(caseItem) {
          const outer = caseItem.href
            ? Object.assign(document.createElement("a"), { href: caseItem.href })
            : document.createElement("article");

          if (outer.tagName === "A") {
            outer.target = "_blank";
            outer.rel = "noopener noreferrer";
            outer.setAttribute("aria-label", `${caseItem.title} on YouTube`);
          }

          outer.className = "tile";
          if (outer.tagName === "ARTICLE") {
            outer.tabIndex = 0;
          }
          outer.dataset.id = caseItem.id;

          if (caseItem.media.kind === "image") {
            const img = document.createElement("img");
            img.className = "media";
            img.src = caseItem.media.src;
            img.alt = caseItem.media.alt;
            outer.append(img);
          }

          if (caseItem.media.kind === "video") {
            const video = document.createElement("video");
            video.className = "media";
            video.src = caseItem.media.src;
            video.autoplay = true;
            video.loop = true;
            video.muted = true;
            video.playsInline = true;
            if (caseItem.media.poster) {
              video.poster = caseItem.media.poster;
            }
            outer.append(video);
          }

          if (caseItem.media.kind === "strip") {
            const strip = document.createElement("div");
            strip.className = "strip";

            caseItem.media.sources.forEach((source) => {
              const video = document.createElement("video");
              video.className = "stripItem";
              video.src = source;
              video.autoplay = true;
              video.loop = true;
              video.muted = true;
              video.playsInline = true;
              strip.append(video);
            });

            outer.append(strip);
          }

          const overlay = document.createElement("div");
          overlay.className = "overlay";

          const title = document.createElement("div");
          title.className = "titleText";
          title.textContent = caseItem.title;

          const copy = document.createElement("div");
          copy.className = "copy";
          copy.textContent = caseItem.copy;

          const roles = document.createElement("div");
          roles.className = "roles";
          roles.textContent = caseItem.roles;

          overlay.append(title, roles, copy);
          outer.append(overlay);

          return outer;
        }

        function render() {
          const filtered = cases.filter(
            (caseItem) =>
              intersectsTags(caseItem, state.selectedTags),
          );

          caseRow.replaceChildren(...filtered.map((caseItem) => renderTile(caseItem)));
        }

        checkboxes.forEach((checkbox) => {
          checkbox.addEventListener("change", (event) => {
            const input = event.currentTarget;
            if (input.checked) {
              state.selectedTags.add(input.value);
            } else {
              state.selectedTags.delete(input.value);
            }
            render();
          });
        });

        render();
      </script>
      <Footer />
    </main>

    <style>
      main {
        padding: 1em;
        max-width: 1280px;
        margin: 0 auto;
      }

      .title {
        font-size: clamp(4rem, 10vw, 8rem);
        margin-bottom: 0.5rem;
        font-weight: bold;
      }

      .filters {
        display: grid;
        gap: 12px;
        margin: 24px 0;
      }

      .tagList {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      :global(.caseRow) {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 8px;
      }

      :global(.tile) {
        flex: 0 0 320px;
        aspect-ratio: 16 / 9;
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
      }

      :global(.media) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      :global(.strip) {
        display: flex;
        width: 100%;
        height: 100%;
      }

      :global(.stripItem) {
        width: 33.333%;
        height: 100%;
        object-fit: cover;
      }

      :global(.overlay) {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
        padding: 1rem;
        pointer-events: none;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.1));
        opacity: 0;
        transition: opacity 200ms ease;
      }

      :global(.tile:hover .overlay),
      :global(.tile:focus-within .overlay),
      :global(.tile:focus-visible .overlay) {
        opacity: 1;
      }

      :global(.titleText) {
        font-weight: 700;
        line-height: 1.2;
      }

      :global(.roles),
      :global(.copy) {
        margin-top: 6px;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 200ms ease, transform 200ms ease;
      }

      :global(.roles) {
        font-size: 0.95rem;
      }

      :global(.copy) {
        font-size: 0.9rem;
      }

      :global(.tile:hover .roles),
      :global(.tile:hover .copy),
      :global(.tile:focus-within .roles),
      :global(.tile:focus-within .copy),
      :global(.tile:focus-visible .roles),
      :global(.tile:focus-visible .copy) {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </body>
</html>
