---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTile from "../components/WorkTile.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getHomeFeed, getHomeTags } from "../lib/work";

const homeFeed = getHomeFeed();
const allTags = getHomeTags();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class ="text-center">
      <h1 class="title">Andy Zou</h1>
      <h2>Video Director & Creative Technologist</h2>

      <div class="filters" aria-label="Case filters">
        <fieldset>
          <legend>Filter by tag</legend>
          <div class="tagList">
            {allTags.map((tag) => (
              <label>
                <input type="checkbox" name="tag" value={tag} />
                {tag}
              </label>
            ))}
          </div>
        </fieldset>

      </div>

      <div id="tilescontainer" class="tilescontainer">
        {homeFeed.map((item) => (
          <WorkTile
            id={item.id}
            type={item.type}
            tags={item.tags}
            title={item.title}
            subtitle={item.subtitle}
            roles={item.roles}
            copy={item.copy}
            media={item.media}
            href={item.href}
            lightboxable={item.type === "video" && item.href.startsWith("http")}
            vertical={item.vertical === true}
            ariaLabel={`${item.title} details`}
          />
        ))}
      </div>
      <VideoLightbox tileSelector="#tilescontainer .tile[data-lightboxable='true']" />

      <script type="module">
        const checkboxes = Array.from(document.querySelectorAll('input[name="tag"]'));
        const tiles = Array.from(document.querySelectorAll("#tilescontainer .tile"));

        function render() {
          const selectedTags = new Set(
            checkboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.value),
          );

          tiles.forEach((tile) => {
            const tags = (tile.dataset.tags || "").split("|").filter(Boolean);
            const visible =
              selectedTags.size === 0 || tags.some((tag) => selectedTags.has(tag));
            tile.hidden = !visible;
          });
        }

        checkboxes.forEach((checkbox) => {
          checkbox.addEventListener("change", render);
        });

        render();
      </script>
      <Footer />
    </main>

    <style>
      main {
        padding: 1em;
        max-width: 1280px;
        margin: 0 auto;
      }

      .title {
        font-size: clamp(4rem, 10vw, 8rem);
        margin-bottom: 0.5rem;
        font-weight: bold;
      }

      .filters {
        display: grid;
        gap: 12px;
        margin: 24px 0;
      }

      .tagList {
        display: flex;
        justify-content:center;
        flex-wrap: wrap;
        gap: 12px;
      }

      .tilescontainer {
        display: flex;
        flex-wrap: wrap;
        justify-content:center;
        align-items:center;
        gap: 16px;
        padding-bottom: 8px;
      }
    </style>
  </body>
</html>
