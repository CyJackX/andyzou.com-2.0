---
import AccordionItem from "../components/AccordionItem.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTile from "../components/WorkTile.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getHomeFeed } from "../lib/work";
import CaseCard from "../components/CaseCard.astro";
import CaseCard2 from "../components/CaseCard2.astro";
import blogPlaceholder2 from "../images/blog-placeholder-2.jpg";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import polygon from "../images/polygon.png";
import pissterine from "../images/pissterine.jpg";
import tootsies from "../images/tootsies_06.06.25-04326-Enhanced-NR.jpg";
import tootsies2 from "../images/tootsies_06.06.25-03807.jpg";
import dbh from "../images/dbh.jpg";
import makingit from "../images/makingit.jpg";
import originals from "../images/originals.jpg";

import Image from "astro/components/Image.astro";

const homeFeed = getHomeFeed();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="text-center">
      <h1 class="title">Andy Zou</h1>
      <h2>Video Director & Creative Technologist</h2>
      <AccordionItem title="Director">
        <div
          class="flex-col md:flex-row md:items-start justify-center items-center flex gap-8 flex-wrap p-8"
        >
          <h2 class="w-full">Featured Projects</h2>
          <div class="hero-tile">
            <Image class="hero-image" src={originals} width="640" height="360" alt="Making It" />
            <div>
              <h3 class="hero-title">Comedy Central Digital</h3>
              <h4 class="hero-subtitle">Director | Producer | Editor</h4>
              <p class="series-copy">
                As a Social Producer at Comedy Central's Webby-winning digital
                team, Andy directed, produced, and edited multiple series like <i
                  >Mini-Mocks</i
                >, music videos, and other original content collaborations with
                notable influencers.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image class="hero-image" src={makingit} width="640" height="360" alt="Making It" />
            <div>
              <h3 class="hero-title">Snap Originals</h3>
              <h4 class="hero-subtitle">Director | DP | Editor</h4>
              <p class="series-copy">
                As Director, Cinematographer, and Editor, Andy brought an
                original vertical series to life for Snapchat's <i
                  >Snap Originals</i
                >.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image class="hero-image" src={dbh} width="640" height="360" alt="Making It" />
            <div>
              <h3 class="hero-title">Death Becomes Her on Broadway</h3>
              <h4 class="hero-subtitle">Director | Producer | Editor</h4>
              <p class="series-copy">
                Directed & Produced a series of promotional BTS interviews for
                Broadway's <i>Death Becomes Her.</i>.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image class="hero-image"
              src="https://i.ytimg.com/vi/_SRIskz2JOY/hqdefault.jpg"
              width="640"
              height="360"
              alt="securocam 3000"
            />
            <div>
              <h3 class="hero-title">Andy's Asian Afterlife</h3>
              <h4 class="hero-subtitle">Creator</h4>
              <p class="series-copy">
                1000$ grand prize winner of Rizzle's Asian Comedy Fest.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image class="hero-image"
              src="https://i.ytimg.com/vi/_SRIskz2JOY/hqdefault.jpg"
              width="640"
              height="360"
              alt="securocam 3000"
            />
            <div>
              <h3 class="hero-title">Securocam 3000</h3>
              <h4 class="hero-subtitle">Co-Creator | Editor</h4>
              <p class="series-copy">
                A short series featured at New York Television Festival and
                hosted on IFC Comedy Crib.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image class="hero-image"
              src="https://i.ytimg.com/vi/klRZB8Q87oY/hqdefault.jpg"
              width="640"
              height="360"
              alt="Apocalypse Problems"
            />
            <div>
              <h3 class="hero-title">Apocalypse Problems</h3>
              <h4 class="hero-subtitle">Director | DP | Editor</h4>
              <p class="series-copy">
                A short series featured on SpoiledNYC ft. Gianmarco Soresi & Megan Sass.
              </p>
            </div>
          </div>
        </div>
        <h2>Other shorts, sketches, and projects</h2>
        <div id="tilescontainer" class="tilescontainer">
          {
            homeFeed.map((item) => (
              <WorkTile
                id={item.id}
                type={item.type}
                title={item.title}
                subtitle={item.subtitle}
                roles={item.roles}
                copy={item.copy}
                media={item.media}
                href={item.href}
                lightboxable={
                  item.type === "video" && item.href.startsWith("http")
                }
                vertical={item.vertical === true}
                ariaLabel={`${item.title} details`}
              />
            ))
          }
        </div>
        <VideoLightbox
          tileSelector="#tilescontainer .tile[data-lightboxable='true']"
        />
        <CaseCard
          id="instant-magenta"
          title="Producing & Other Creative Services"
          imageSrc={blogPlaceholder2}
          imageAlt="Instant Magenta Collage"
          reverse
        >
          From editing for Hollywood socials to full-service promos for Broadway
          productions, Andy can lend a hand through his production arm <a
            href="www.instantmagenta.com"
            class="text-nowrap"
            target="_blank">Instant Magenta</a
          >.
        </CaseCard>
      </AccordionItem>
      <AccordionItem title="Technologist">
        <CaseCard
          id="tech"
          videoSrc="/videos/Tootsies Promo v1_2_400.mp4"
          reverse
        >
          With a background in Mathematics & Computer Science, Andy has always
          embraced the technical aspects of production. From coding custom After
          Effects scripts to niche immersive workflows, he enjoys the tinkering.
        </CaseCard>
        <CaseCard id="tech" videoSrc="/videos/Head to Head_640.mp4">
          Andy's breadth of experience includes traditional 3D tools such as
          Unreal Engine, Unity, Blender, and more.
        </CaseCard>
        <CaseCard id="ai" videoSrc="/videos/AI Sample_400.mp4" reverse>
          But Andy also knows how to grow with the times, dabbling in AI-driven
          generative workflows from platforms like Higgsfield and Kling to
          API-driven bespoke applications such as ComfyUI and Veo3.
        </CaseCard>
      </AccordionItem>
      <AccordionItem title="Weirdo">
        <div class="flex flex-row gap-8 p-8 flex-wrap justify-center">
          <a
            class="hero-tile"
            href="https://www.kickstarter.com/projects/andyzou/pissterine-a-genuine-novelty-mouthwash"
          >
            <Image src={pissterine} width="640" height="360" alt="Making It" />
            <div>
              <h3 class="hero-title">Pissterine</h3>
              <p class="series-copy">
                Andy once kickstarted a Listerine knockoff that got shutdown in
                trademark court.
              </p>
            </div>
          </a>
          <a
            class="hero-tile"
            href="https://tootsiesvideovault.com"
            target="_blank"
          >
            <Image
              src={tootsies}
              width="640"
              height="360"
              alt="Making It"
              class="aspect-video object-cover"
            />
            <div>
              <h3 class="hero-title">Tootsies Video Vault</h3>
              <p class="series-copy">
                Andy is a co-producer on annual Brooklyn film jam
                www.TootsiesVideoVault.com.
              </p>
            </div>
          </a>
          <h2 class="w-full mt-8">Timeless Fan Favorites</h2>
          <WorkTilebyId id="tuber" />
          <WorkTilebyId id="andys-roadshow" />
          <div class="hero-tile">
            <Image
              src={azaleaShoot}
              width="640"
              height="360"
              alt="Making It"
              class="aspect-video object-cover object-top"
            />
            <div>
              <h3 class="hero-title"></h3>
              <p class="series-copy">
                Andy lives in Brooklyn with his wife and collaborator Katie
                Sicking and their daughter Azalea.
              </p>
            </div>
          </div>
        </div>
      </AccordionItem>

      <Footer />

      <style>
        .hero-tile {
          position: relative;
          isolation: isolate;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 1em;
          flex: 1 1 360px;
          cursor: pointer;
          border-radius: 12px;
          align-self: stretch;
          text-decoration: none;
          color: white;
        }

        .hero-tile::after {
          content: "";
          position: absolute;
          inset: 0;
          border-radius: inherit;
          background-color: rgba(255, 255, 255, 0.08);
          opacity: 0;
          transition: opacity 160ms ease;
          pointer-events: none;
          z-index: 2;
        }

        .hero-tile:hover::after {
          opacity: 1;
        }

        .hero-tile > * {
          position: relative;
          z-index: 1;
        }

        .hero-image {
          aspect-ratio: 16/9;
          object-fit: cover;
          border-radius: 12px;
        }

        .hero-title {
          font-size: 2.4rem;
          font-weight: bold;
        }
        .hero-subtitle {
          font-size: 2rem;
        }
        .series-copy {
          margin-top: 0.5em;
          padding: 0 2em;
        }

        main {
          padding: 1em;
          max-width: 1280px;
          margin: 0 auto;
        }

        .title {
          font-size: clamp(4rem, 10vw, 8rem);
          margin-bottom: 0.5rem;
          font-weight: bold;
        }

        .tilescontainer {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          gap: 16px;
          padding-bottom: 8px;
        }
      </style>
    </main>
  </body>
</html>
