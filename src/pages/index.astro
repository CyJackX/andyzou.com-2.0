---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTile from "../components/WorkTile.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import WorkTilesBySeries from "../components/WorkTilesBySeries.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getPublishedBlogPosts } from "../lib/blog";
import {
  buildPersonJsonLd,
  buildWebSiteJsonLd,
  summarizeText,
} from "../lib/seo";

function formatGalleryAlt(filePath: string) {
  const filename =
    filePath
      .split("/")
      .pop()
      ?.replace(/\.[^.]+$/, "") ?? "Andy photo";

  return filename.replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();
}

const andyGalleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../images/andy/*.{jpg,jpeg,png,webp,avif}",
    { eager: true },
  ),
)
  .map(([filePath, module]) => ({
    alt: formatGalleryAlt(filePath),
    src: module.default,
  }))
  .sort((a, b) =>
    a.alt.localeCompare(b.alt, undefined, {
      numeric: true,
      sensitivity: "base",
    }),
  );

const blogDateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const latestBlogPosts = (await getPublishedBlogPosts())
  .slice(0, 3)
  .map((post) => ({
    id: `blog-${post.id}`,
    title: post.data.title,
    subtitle: blogDateFormatter.format(post.data.pubDate),
    copy: post.data.description,
    href: `/blog/${post.id}/`,
    media: {
      kind: "image" as const,
      src: post.data.heroImage ?? "/blog-placeholder-1.jpg",
      alt: post.data.heroImageAlt,
    },
  }));

const pageDescription = summarizeText(
  "Andy Zou is a director and creative technologist creating comedy, branded content, and technical experiments across video, interactive media, and the web.",
);
const jsonLd = Astro.site
  ? [buildWebSiteJsonLd(Astro.site), buildPersonJsonLd(Astro.site)]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={pageDescription || SITE_DESCRIPTION}
      image={azaleaShoot.src}
      imageAlt="Portrait of Andy Zou on set"
      jsonLd={jsonLd}
    />
  </head>
  <body
    >
    <main class="text-center">
      <Header />
      <VideoLightbox tileSelector="[data-lightboxable='true']" />
      <!-- <ol class="tilescontainer">
        <WorkTileByID id="directing-reel" />
      </div> -->

      <div>
        <details id="scripted-digital-series" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Scripted Series</h2></summary
          >
          <ol class="tilescontainer">
            <WorkTilesBySeries seriesId="series" deferMedia={true} />
          </ol>
        </details>

        <details id="branded-content" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Branded Content</h2></summary
          >
          <p class="copy">
            After a decade of making digital content for publishers, brands, and
            comedy platforms, Andy now channels that production experience into
            nimble campaign and branded work through <a
              href="https://www.instantmagenta.com"
              class="underline">Instant Magenta.</a>
          </p>
          <ol class="tilescontainer">
            <WorkTilesBySeries seriesId="branded-content" deferMedia={true} />
          </ol>
        </details>

        <details id="sketches-shorts" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">
              Sketches & Shorts
            </h2></summary
          >
          <p class="copy">
            An alum of Upright Citizen's Brigade and NYU's Hammerkatz, Andy has
            worked closely with the local comedy scene for years as a go-to
            director, DP, and editor.
          </p>
          <ol class="tilescontainer">
            <WorkTilesBySeries seriesId="sketch" deferMedia={true} />
            <WorkTilesBySeries seriesId="shorts" deferMedia={true} />
          </ol>
        </details>
        <details id="music-videos" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Music Videos</h2></summary
          >
          <p class="copy">
            One of Andy's favorite mediums, he loves the creative freedom and
            emotional resonance that comes from a great music video.
          </p>
          <ol class="tilescontainer">
            <WorkTilesBySeries seriesId="music-videos" deferMedia={true} />
          </ol>
        </details>
        <details id="fan-favorites" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Fan Favorites</h2></summary
          >
          <p class="copy">
            Just some classic Andy. These are what his friends bring up the
            most.
          </p>
          <ol class="tilescontainer">
            <li>
              <WorkTilebyId id="andys-roadshow" deferMedia={true} />
            </li>
            <li>
              <WorkTilebyId id="pissterine" target="_blank" deferMedia={true} />
            </li>
            <li><WorkTilebyId id="tuber" deferMedia={true} /></li>
          </ol>
        </details>
      </div>
      <!-- <details id="scripted-digital-series" name="director-subsection">
        <summary><h2 class="section-title bigtitle">Creative</h2></summary><ol
          class="tilescontainer"
        >
          <li>Polygon</li>
          <li>Escadating</li>
          <li>Immersive?</li>
        </ol>
      </details> -->

      <details id="technology" name="director-subsection">
        <summary><h2 class="section-title subsection">Technology</h2></summary>
        <p class="copy">
          From After Effects to VR, 3D engines, genAI, webdev, and
          more, Andy has a wide range of technical skills that support his work
          as a director and an editor.
        </p>
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="tech" deferMedia={true} />
        </ol>
        <p class="copy">
          He blogs occasionally about tech right <a
            href="/blog"
            target="_blank"
            class="underline">here!</a
          >
        </p>
        <ol class="tilescontainer">
          {
            latestBlogPosts.map((post) => (
              <li>
                <WorkTile
                  id={post.id}
                  type="series"
                  title={post.title}
                  subtitle={post.subtitle}
                  copy={post.copy}
                  media={post.media}
                  href={post.href}
                  deferMedia={true}
                />
              </li>
            ))
          }
        </ol>
      </details>
      <!-- 
      <details id="scripted-digital-series" name="director-subsection">
        <summary
          ><h2 class="section-title bigtitle">Unscripted Editor</h2></summary
        >
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="editing"  />
        </ol>
      </details> -->

      <details id="about" name="director-subsection">
        <summary
          ><h2 class="section-title subsection">About</h2></summary
        >
        <p class="copy">
          With a background in Experimental Theatre & Computer Science, Andy has
          been hands-on as a director throughout his career. From creative
          writing to line producing, cinematography to editing, Andy's done it
          all, going from a scrappy one-man band to directing for Comedy Central
          Digital. His holistic production experience gives him the skills to
          navigate complex productions and take projects smoothly from script to
          screen. As a director, Andy's priority is tapping in to the audience
          experience. When you need someone that knows how to make scrappiness
          work at scale, reach out at Andy@AndyZou.com
        </p>
        <ol class="flex flex-wrap gap-8 items-start justify-center my-8">
          {
            andyGalleryImages.map((image) => (
              <li>
                <a
                  href={image.src.src}
                  class="gallery-lightbox"
                  data-lightboxable="true"
                  data-title={image.alt}
                  aria-label={`${image.alt} full image`}
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    height="640"
                    loading="lazy"
                    class="h-60 w-auto md:h-85 block"
                  />
                </a>
              </li>
            ))
          }

          <li class="max-w-4xl">
            <a
              href={azaleaShoot.src}
              class="gallery-lightbox"
              data-lightboxable="true"
              data-title="Bug Family"
              aria-label={`Family Bugs full image`}
            >
              <Image
                src={azaleaShoot}
                alt="Bug Family"
                height="640"
                loading="lazy"
                class="aspect-video object-cover"
              />
            </a>
            <p class="px-8 m-8">
              Andy lives in Brooklyn with his wife and collaborator Katie
              Sicking and their daughter Azalea.
            </p>
          </li>
          <li>
            <div>
              <WorkTilebyId
                id="tootsies"
                target="_blank"
                className="max-w-[560px] w-full mx-auto"
                deferMedia={true}
              />
            </div>
            <p class="px-8 m-8">
              He's also a co-producer on annual short film festival <a
                class="text-nowrap underline"
                href="https://www.tootsiesvideovault.com"
                target="_blank"
              >
                Tootsie's Video Vault!</a
              >
            </p>
          </li>
        </ol>
      </details>
    </main>
    <script>
      import { initIndexPage } from "../scripts/indexPage";

      initIndexPage();
    </script>
  </body><Footer />

  <style>
    :root {
      interpolate-size: allow-keywords;
    }

    details {
      position: relative;
      overflow: hidden;
    }

    details::after {
      position: absolute;
      content: "";
      inset: 0;
      pointer-events: none;
    }

    details::details-content {
      block-size: 0;
      transition:
        block-size 0.5s,
        content-visibility 0.5s;
      transition-behavior: allow-discrete;
    }

    details:open::details-content {
      block-size: auto;
    }

    summary {
      list-style: none;
    }

    .section-title:hover {
      background-color: rgb(var(--gray-light));
      color: rgb(var(--black));
    }

    .section-title:hover .header-video {
      display: none;
    }
    /* 
    .subsection {
      width: fit-content;
      margin: 0 auto;
    }

    @media (max-width: 768px) {
      .subsection {
        font-size: 1.75em;
      }
    }
      */

    .gallery-lightbox {
      display: block;
      border-radius: 12px;
      overflow: hidden;
    }

    @media (min-width: 768px) {
      .tilescontainer.two-col {
        grid-template-columns: repeat(2, minmax(320px, 1fr));
      }
    }
  </style>
</html>
