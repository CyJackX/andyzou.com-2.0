---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import WorkTilesBySeries from "../components/WorkTilesBySeries.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import pissterine from "../images/pissterine.jpg";
import tootsies from "../images/tootsies_06.06.25-04326-Enhanced-NR.jpg";
import mirum from "../images/mirum vr.jpg";
import { Image } from "astro:assets";
import WorkTileByID from "../components/WorkTileByID.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="text-center">
      <VideoLightbox
        tileSelector=".tile[data-lightboxable='true'], .hero-tile[data-lightboxable='true']"
      />
      <!-- <ol class="tilescontainer">
        <WorkTileByID id="directing-reel" />
      </div> -->
      <details name="close-together" open>
        <summary class="header section-title">
          <h1 class="bigtitle">Andy Zou</h1>
          <video src="videos/Comp 1.mp4" muted loop autoplay />
          <p class="subtitle">
            <span>Director & Creative</span>
            <span>Andy@AndyZou.com</span>
          </p>
        </summary>
        <p class="text-5xl text-left py-8">
          Andy Zou is a director and creative based in Brooklyn. With a
          background in comedy and a passion for storytelling, he has directed a
          wide range of projects, from scripted digital series to branded
          content, music videos, and more. His work is known for its humor,
          heart, and visual flair.
        </p>
        <div></div>
      </details>

      <details name="close-together">
        <summary
          ><h2 class="section-title bigtitle">
            Scripted Digital Series
          </h2></summary
        >
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="series" className="tile-series" />
        </ol>
      </details>

      <details name="close-together">
        <summary
          ><h2 class="section-title bigtitle">Branded Content</h2></summary
        >
        <ol class="tilescontainer">
          <WorkTilesBySeries
            seriesId="branded-content"
            className="tile-series"
          />
        </ol>
      </details>

      <details name="close-together">
        <summary><h2 class="section-title bigtitle">Sketch Comedy</h2></summary>
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="sketch" className="tile-series" />
        </ol>
      </details>

      <details name="close-together">
        <summary><h2 class="section-title bigtitle">Music Videos</h2></summary>
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="music-videos" className="tile-series" />
        </ol>
      </details>

      <details name="close-together">
        <summary><h2 class="section-title bigtitle">Short Films</h2></summary>
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="shorts" className="tile-series" />
        </ol>
      </details>
      <details name="close-together">
        <summary
          ><h2 class="section-title bigtitle">
            Timeless Fan Favorites
          </h2></summary
        ><ol class="tilescontainer">
          <li><WorkTilebyId id="tuber" className="tile-series" /></li>
          <li><WorkTilebyId id="andys-roadshow" className="tile-series" /></li>
          <li>
            <WorkTilebyId
              id="pissterine"
              className="tile-series"
              target="_blank"
            />
          </li>
        </ol>
      </details>

      <details name="close-together">
        <summary><h2 class="section-title bigtitle">Technologist</h2></summary>
        <ol class="tilescontainer">
          <li>
            <p class="text-4xl text-left p-4">
              From After Effects compositing to experience with VR streaming, 3D
              engines, genAI, and more, Andy has a wide range of technical
              skills that he applies to his work as a director and an editor.
            </p>
          </li>
          <WorkTilesBySeries seriesId="tech" className="tile-series" />
          <li>
            <video
              src="/videos/tootsiespromo.mp4"
              muted
              loop
              autoplay
              class="tile"></video>
          </li>
          <!-- <Image src={mirum} height="360" alt="Mirum VR BTS" class="tile" /> -->
          <li>
            <video
              src="/videos/Head to Head_640.mp4"
              muted
              loop
              autoplay
              class="tile"></video>
          </li>
        </ol>
      </details>

      <details name="close-together">
        <summary
          ><h2 class="section-title bigtitle">Unscripted Editor</h2></summary
        >
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="editing" className="tile-series" />
        </ol>
      </details>

      <details name="close-together">
        <summary><h2 class="section-title bigtitle">Weirdo</h2></summary>
        <ol class="tilescontainer">
          <li>
            <Image
              src={azaleaShoot}
              width="1280"
              height="720"
              alt="Making It"
              class="aspect-video object-cover w-full object-top rounded-lg"
              loading="lazy"
            />
            <p class="px-8 m-8">
              Andy lives in Brooklyn with his wife and collaborator Katie
              Sicking and their daughter Azalea.
            </p>
          </li>
          <li>
            <WorkTilebyId id="tootsies" target="_blank" /><p class="px-8 m-8">
              He's also a co-producer on annual short film festival <a
                class="text-nowrap"
                href="https://www.tootsiesvideovault.com"
                target="_blank"
              >
                Tootsie's Video Vault!</a
              >
            </p>
          </li>
        </ol>
      </details>
    </main>
  </body><Footer />

  <style>
    :root {
      interpolate-size: allow-keywords;
    }

    details {
      position: relative;
      overflow: hidden;
    }

    details::after {
      position: absolute;
      content: "";
      inset: 0;
      pointer-events: none;
      border-bottom: 0.5cqw solid white;
    }

    details::details-content {
      block-size: 0;
      transition:
        block-size 0.5s,
        content-visibility 0.5s;
      transition-behavior: allow-discrete;
    }

    details:open::details-content {
      block-size: auto;
    }
    summary {
      width: 100%;
      list-style: none;
    }

    .section-title {
      border-bottom: 0.5cqw solid white;
      width: 100%;
      text-align: left;
      font-weight: bold;
      cursor: pointer;
      user-select: none;
    }

    .section-title:hover {
      background-color: white;
      color: black;
    }

    .header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: end;
    }

    .subtitle {
      font-size: 3cqw;
      line-height: 1.25;
      display: flex;
      flex-direction: column;

      text-align: justify;
      text-justify: inter-word;
      text-align-last: justify;
    }
  </style>
</html>

