---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import WorkTileBySeriesID from "../components/WorkTileBySeriesID.astro";
import WorkTilesBySeries from "../components/WorkTilesBySeries.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  buildOrganizationJsonLd,
  buildPersonJsonLd,
  buildWebSiteJsonLd,
  summarizeText,
} from "../lib/seo";

function formatGalleryAlt(filePath: string) {
  const filename =
    filePath
      .split("/")
      .pop()
      ?.replace(/\.[^.]+$/, "") ?? "Andy photo";

  return filename.replace(/[-_]+/g, " ").replace(/\s+/g, " ").trim();
}

const andyGalleryImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../images/andy/*.{jpg,jpeg,png,webp,avif}",
    { eager: true },
  ),
)
  .map(([filePath, module]) => ({
    alt: formatGalleryAlt(filePath),
    src: module.default,
  }))
  .sort((a, b) =>
    a.alt.localeCompare(b.alt, undefined, {
      numeric: true,
      sensitivity: "base",
    }),
  );

const pageDescription = summarizeText(
  "Andy Zou is a director and creative technologist creating comedy, branded content, and technical experiments across video, interactive media, and the web.",
);
const jsonLd = Astro.site
  ? [
      buildWebSiteJsonLd(Astro.site),
      buildPersonJsonLd(Astro.site),
      buildOrganizationJsonLd(),
    ]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={pageDescription || SITE_DESCRIPTION}
      image={azaleaShoot.src}
      imageAlt="Portrait of Andy Zou and family."
      jsonLd={jsonLd}
    />
    <script is:inline>
      const ua = navigator.userAgent;
      const isIOSDevice =
        /iPhone|iPad|iPod/i.test(ua) ||
        (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
      const isDesktopSafari =
        /Safari/i.test(ua) && !/Chrome|Chromium|Edg|OPR/i.test(ua);

      if (isIOSDevice || isDesktopSafari) {
        document.documentElement.classList.add("webkit-details-fallback");
      }
    </script>
  </head>
  <body>
    <Header />
    <main class="text-center">
      <VideoLightbox tileSelector="[data-lightboxable='true']" />
      <!-- <ol class="tilescontainer">
        <WorkTileByID id="directing-reel" />
      </div> -->

      <div>
        <details id="scripted-digital-series" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Scripted Series</h2></summary
          >
          <p class="copy">
            A collection of longer-form episodic projects.
          </p>
          <ol class="tilescontainer">
            <li class="list-none">
              <WorkTileBySeriesID
                seriesId="comedy-central-originals"
                deferMedia={true}
              />
            </li>
            <li class="list-none">
              <WorkTileBySeriesID seriesId="making-it" deferMedia={true} />
            </li>
            <li class="list-none">
              <WorkTileBySeriesID
                seriesId="asian-afterlife"
                deferMedia={true}
              />
            </li>
            <li class="list-none">
              <WorkTilebyId
                id="securocam-3000"
                lightboxable={false}
                deferMedia={true}
              />
            </li>
            <li class="list-none">
              <WorkTileBySeriesID
                seriesId="apocalypse-problems"
                deferMedia={true}
              />
            </li>
            <li class="list-none">
              <WorkTileBySeriesID
                seriesId="the-honest-waitress"
                deferMedia={true}
              />
            </li>
          </ol>
        </details>

        <details id="branded-content" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Branded Content</h2></summary
          >
          <p class="copy">
            Client work & more thru Andy's boutique production company <a
              href="https://www.instantmagenta.com"
              class="underline">Instant Magenta</a
            >!
          </p>
          <ol class="tilescontainer">
            <li class="list-none">
              <WorkTileBySeriesID
                seriesId="death-becomes-her"
                deferMedia={true}
              />
            </li>
            <WorkTilesBySeries seriesId="branded-content" deferMedia={true} />
          </ol>
        </details>

        <details id="sketches-shorts" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">
              Sketches & Shorts
            </h2></summary
          >
          <p class="copy">
            An alum of Upright Citizen's Brigade and NYU's Hammerkatz, Andy has
            been a go-to director, DP, and editor for the local comedy scene.
          </p>
          <ol class="tilescontainer">
            <WorkTilesBySeries seriesId="sketch" deferMedia={true} />
            <WorkTilesBySeries seriesId="shorts" deferMedia={true} />
          </ol>
        </details>
        <details id="music-videos" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Music Videos</h2></summary
          >
          <ol class="tilescontainer">
            <WorkTilesBySeries seriesId="music-videos" deferMedia={true} />
          </ol>
        </details>
        <details id="fan-favorites" name="director-subsection">
          <summary
            ><h2 class="section-title subsection">Fan Favorites</h2></summary
          >
          <p class="copy">
            Just some classic Andy. (These are what his friends bring up the
            most.)
          </p>
          <ol class="tilescontainer">
            <li>
              <WorkTilebyId id="andys-roadshow" deferMedia={true} />
            </li>
            <li>
              <WorkTilebyId id="pissterine" target="_blank" deferMedia={true} />
            </li>
            <li><WorkTilebyId id="tuber" deferMedia={true} /></li>
          </ol>
        </details>
      </div>
      <!-- <details id="scripted-digital-series" name="director-subsection">
        <summary><h2 class="section-title bigtitle">Creative</h2></summary><ol
          class="tilescontainer"
        >
          <li>Polygon</li>
          <li>Escadating</li>
          <li>Immersive?</li>
        </ol>
      </details> -->

      <details id="technology" name="director-subsection">
        <summary><h2 class="section-title subsection">Technologist</h2></summary
        >
        <p class="copy">
          From After Effects to VR, 3D engines, genAI, webdev, and more, Andy
          has a wide range of technical skills that support his work as a
          director and an editor. Check out some devlogs below from his <a
            href="https://www.youtube.com/@YoAndyZou"
            target="_blank"
            rel="me noopener noreferrer" class="underline">Youtube!</a
          >
        </p>
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="tech" deferMedia={true} />
        </ol>
      </details>
      <h2 class="section-title subsection"><a href="/blog/" class="block">Blog</a></h2>
      <!-- 
      <details id="scripted-digital-series" name="director-subsection">
        <summary
          ><h2 class="section-title bigtitle">Unscripted Editor</h2></summary
        >
        <ol class="tilescontainer">
          <WorkTilesBySeries seriesId="editing"  />
        </ol>
      </details> -->

      <details id="about" name="director-subsection">
        <summary
          ><h2 class="section-title subsection">About & Contact</h2></summary
        >
        <p class="copy">
          With an unconventional background in experimental theatre and computer science, I have always had a unique approach to creativity in my hands-on career. From writing and line producing to cinematography and editing, I went from a scrappy one-man band to directing and producing at Comedy Central Digital & more. I see myself as more than a creative—I’m a creative <i>problem-solver</i> who enjoys finding technical and logistical solutions to interesting problems. My holistic experiences give me the perspective to navigate the challenges of modern, tech-forward productions and take ideas smoothly from script to screen. And ultimately, as a director, my main focus is on my audience and finding what will resonate on a human level. If you have some unique creative problems that require out-of-the-box thinking, reach out at
          <span id="about-email-link" data-email-container hidden></span> to find out how we can work together.
        </p>
        <ol class="flex flex-wrap gap-8 items-start justify-center my-8">
          {
            andyGalleryImages.map((image) => (
              <li>
                <a
                  href={image.src.src}
                  class="gallery-lightbox"
                  data-lightboxable="true"
                  data-title={image.alt}
                  aria-label={`${image.alt} full image`}
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    height="640"
                    loading="lazy"
                    class="h-60 w-auto md:h-85 block"
                  />
                </a>
              </li>
            ))
          }

          <li class="max-w-4xl">
            <a
              href={azaleaShoot.src}
              class="gallery-lightbox"
              data-lightboxable="true"
              data-title="Bug Family"
              aria-label={`Family Bugs full image`}
            >
              <Image
                src={azaleaShoot}
                alt="Bug Family"
                height="640"
                loading="lazy"
                class="aspect-video object-cover"
              />
            </a>
            <p class="px-8 m-8">
              Andy lives in Brooklyn with his wife and collaborator Katie
              Sicking and their daughter Azalea.
            </p>
          </li>
          <li>
            <div>
              <WorkTilebyId
                id="tootsies"
                target="_blank"
                className="max-w-[560px] w-full mx-auto"
                deferMedia={true}
              />
            </div>
            <p class="px-8 m-8">
              He's also a co-producer on annual short film festival <a
                class="text-nowrap underline"
                href="https://www.tootsiesvideovault.com"
                target="_blank"
              >
                Tootsie's Video Vault!</a
              >
            </p>
          </li>
        </ol>
      </details>
    </main>
    <Footer />
    <script>
      import { initIndexPage } from "../scripts/indexPage";

      initIndexPage();

      const aboutSection = document.querySelector("#about");
      const emailContainer = document.querySelector("[data-email-container]");

      if (
        aboutSection instanceof HTMLDetailsElement &&
        emailContainer instanceof HTMLElement
      ) {
        const revealEmail = () => {
          if (!aboutSection.open || emailContainer.childElementCount > 0) {
            return;
          }

          const localPart = ["Andy", "@", "AndyZou"].join("");
          const domain = ["com"].join("");
          const email = `${localPart}.${domain}`;

          emailContainer.hidden = false;
          emailContainer.innerHTML = "";

          const emailLink = document.createElement("a");
          emailLink.href = `mailto:${email}`;
          emailLink.className = "underline";
          emailLink.textContent = email;

          emailContainer.append(" ", emailLink);
        };

        aboutSection.addEventListener("toggle", revealEmail);
        revealEmail();
      }
    </script>
  </body>

  <style>
    :root {
      interpolate-size: allow-keywords;
    }

    details {
      position: relative;
      overflow: hidden;
    }

    :root.webkit-details-fallback details {
      display: flow-root;
      overflow: visible;
    }

    details::after {
      position: absolute;
      content: "";
      inset: 0;
      pointer-events: none;
    }

    :root:not(.webkit-details-fallback) details::details-content {
      block-size: 0;
      transition:
        block-size 0.5s,
        content-visibility 0.5s;
      transition-behavior: allow-discrete;
    }

    :root:not(.webkit-details-fallback) details[open]::details-content,
    :root:not(.webkit-details-fallback) details:open::details-content {
      block-size: auto;
    }

    summary {
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary::marker {
      content: "";
    }

    .section-title:hover {
      background-color: rgb(var(--gray-light));
      color: rgb(var(--black));
    }

    .section-title:hover .header-video {
      display: none;
    }
    /* 
    .subsection {
      width: fit-content;
      margin: 0 auto;
    }

    @media (max-width: 768px) {
      .subsection {
        font-size: 1.75em;
      }
    }
      */

    .gallery-lightbox {
      display: block;
      border-radius: 12px;
      overflow: hidden;
    }

    @media (min-width: 768px) {
      .tilescontainer.two-col {
        grid-template-columns: repeat(2, minmax(320px, 1fr));
      }
    }
  </style>
</html>
