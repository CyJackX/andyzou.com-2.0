---
import AccordionItem from "../components/AccordionItem.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTilebyId from "../components/WorkTileByID.astro";
import WorkTilesBySeries from "../components/WorkTilesBySeries.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import CaseCard from "../components/CaseCard.astro";
import blogPlaceholder2 from "../images/blog-placeholder-2.jpg";
import azaleaShoot from "../images/AzaleaShootSelects-07.jpg";
import pissterine from "../images/pissterine.jpg";
import tootsies from "../images/tootsies_06.06.25-04326-Enhanced-NR.jpg";
import dbh from "../images/dbh.jpg";
import originals from "../images/originals.jpg";

import Image from "astro/components/Image.astro";

import Titleheader from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Titleheader />
    <main class="text-center">
      <VideoLightbox
        tileSelector="#tilescontainer .tile[data-lightboxable='true']"
      />
      <AccordionItem title="Director">
        <div
          class="flex-col md:flex-row md:items-start justify-center items-center flex gap-8 flex-wrap p-8"
        >
          <h2 class="section-title">Featured Series</h2>
          <div class="hero-tile">
            <Image
              class="hero-image"
              src={originals}
              width="640"
              height="360"
              alt="Making It"
            />
            <div>
              <h3 class="hero-title">Comedy Central Digital</h3>
              <h4 class="hero-subtitle">Director | Producer | Editor</h4>
              <p class="series-copy">
                At Comedy Central's Webby-winning Digital team, Andy directed &
                produced multiple series like <i>Mini-Mocks</i>, music videos,
                and other content collabs with notable influencers.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <video
              src="/videos/makingit.mp4"
              autoplay
              loop
              muted
              playsinline
              class="hero-image"></video>
            <div>
              <h3 class="hero-title">Making It - Snap Originals</h3>
              <h4 class="hero-subtitle">Director | DP | Editor</h4>
              <p class="series-copy">
                As Director, Cinematographer, and Editor, Andy brought an
                original vertical series to life for Snapchat's <i
                  >Snap Originals</i
                >.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image
              class="hero-image"
              src={dbh}
              width="640"
              height="360"
              alt="Making It"
            />
            <div>
              <h3 class="hero-title">Death Becomes Her on Broadway</h3>
              <h4 class="hero-subtitle">Director | Producer | Editor</h4>
              <p class="series-copy">
                Directed & Produced a series of promotional BTS interviews for
                Broadway's <i class="text-nowrap">Death Becomes Her.</i>
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <div class="flex border-radius-lg">
              <video
                src={"/videos/rizzle3.mp4"}
                class="rizzlevideo"
                autoplay
                loop
                muted
                playsinline></video>
              <video
                src={"/videos/rizzle1.mp4"}
                class="rizzlevideo"
                autoplay
                loop
                muted
                playsinline></video>
              <video
                src={"/videos/rizzle2.mp4"}
                class="rizzlevideo"
                autoplay
                loop
                muted
                playsinline></video>
            </div>
            <div>
              <h3 class="hero-title">Andy's Asian Afterlife</h3>
              <h4 class="hero-subtitle">Creator</h4>
              <p class="series-copy">
                1000$ grand prize winner of Rizzle's Asian Comedy Fest.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image
              class="hero-image"
              src="https://i.ytimg.com/vi/_SRIskz2JOY/hqdefault.jpg"
              width="640"
              height="360"
              alt="securocam 3000"
            />
            <div>
              <h3 class="hero-title">Securocam 3000</h3>
              <h4 class="hero-subtitle">Co-Creator | Editor</h4>
              <p class="series-copy">
                A short series featured at New York Television Festival and
                hosted on IFC Comedy Crib.
              </p>
            </div>
          </div>
          <div class="hero-tile">
            <Image
              class="hero-image"
              src="https://i.ytimg.com/vi/klRZB8Q87oY/hqdefault.jpg"
              width="640"
              height="360"
              alt="Apocalypse Problems"
            />
            <div>
              <h3 class="hero-title">Apocalypse Problems</h3>
              <h4 class="hero-subtitle">Director | DP | Editor</h4>
              <p class="series-copy">
                A short series featured on SpoiledNYC ft. Gianmarco Soresi &
                Megan Sass.
              </p>
            </div>
          </div>
        </div>
        <h2 class="section-title">Branded Content</h2>
        <div id="tilescontainer" class="tilescontainer">
          <WorkTilesBySeries seriesId="branded-content" />
        </div>
        <h2 class="section-title">Comedy Music Videos</h2>
        <div id="tilescontainer" class="tilescontainer">
          <WorkTilesBySeries seriesId="music-videos" />
        </div>
        <h2 class="section-title">Short Films</h2>
        <div id="tilescontainer" class="tilescontainer">
          <WorkTilesBySeries seriesId="shorts" />
        </div>
        <h2 class="section-title">Other Shorts & Sketches</h2>
        <div id="tilescontainer" class="tilescontainer">
          <WorkTilesBySeries seriesId="home" />
        </div>
      </AccordionItem>
      <AccordionItem title="Technologist">
        <CaseCard
          id="tech"
          videoSrc="/videos/Tootsies Promo v1_2_400.mp4"
          reverse
        >
          With a background in Mathematics & Computer Science, Andy has always
          embraced the technical aspects of production. From coding custom After
          Effects scripts to niche immersive workflows, he enjoys the tinkering.
        </CaseCard>
        <CaseCard id="tech" videoSrc="/videos/Head to Head_640.mp4">
          Andy's breadth of experience includes traditional 3D tools such as
          Unreal Engine, Unity, Blender, and more.
        </CaseCard>
        <CaseCard id="ai" videoSrc="/videos/AI Sample_400.mp4" reverse>
          But Andy also knows how to grow with the times, dabbling in AI-driven
          generative workflows from platforms like Higgsfield and Kling to
          API-driven bespoke applications such as ComfyUI and Veo3.
        </CaseCard>
      </AccordionItem>
      <AccordionItem title="Weirdo">
        <div class="flex flex-row gap-8 p-8 flex-wrap justify-center">
          <a
            class="hero-tile"
            href="https://www.kickstarter.com/projects/andyzou/pissterine-a-genuine-novelty-mouthwash"
          >
            <Image src={pissterine} width="640" height="360" alt="Making It" />
            <div>
              <h3 class="hero-title">Pissterine</h3>
              <p class="series-copy">
                Andy once kickstarted a Listerine knockoff that got shutdown in
                trademark court.
              </p>
            </div>
          </a>
          <a
            class="hero-tile"
            href="https://tootsiesvideovault.com"
            target="_blank"
          >
            <Image
              src={tootsies}
              width="640"
              height="360"
              alt="Making It"
              class="aspect-video object-cover"
            />
            <div>
              <h3 class="hero-title">Tootsies Video Vault</h3>
              <p class="series-copy">
                Andy is a co-producer on annual Brooklyn film jam
                www.TootsiesVideoVault.com.
              </p>
            </div>
          </a>
          <h2 class="section-title">Timeless Fan Favorites</h2>
          <WorkTilebyId id="tuber" />
          <WorkTilebyId id="andys-roadshow" />
          <div class="hero-tile">
            <Image
              src={azaleaShoot}
              width="640"
              height="360"
              alt="Making It"
              class="aspect-video object-cover object-top"
            />
            <div>
              <h3 class="hero-title"></h3>
              <p class="series-copy">
                Andy lives in Brooklyn with his wife and collaborator Katie
                Sicking and their daughter Azalea.
              </p>
            </div>
          </div>
        </div>
      </AccordionItem>

      <Footer />

      <style>
        .section-title {
          width: 100%;
          margin-top: 0.5em;
        }

        .hero-tile {
          position: relative;
          isolation: isolate;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 1em;
          flex: 0 1 360px;
          cursor: pointer;
          border-radius: 12px;
          align-self: stretch;
          text-decoration: none;
          color: white;
        }

        .hero-tile::after {
          content: "";
          position: absolute;
          inset: 0;
          border-radius: inherit;
          background-color: rgba(255, 255, 255, 0.08);
          opacity: 0;
          transition: opacity 160ms ease;
          pointer-events: none;
          z-index: 2;
        }

        .hero-tile:hover::after {
          opacity: 1;
        }

        .hero-tile > * {
          position: relative;
          z-index: 1;
        }

        .hero-image {
          aspect-ratio: 16/9;
          object-fit: cover;
          border-radius: 12px;
        }

        .rizzlevideo {
          width: 33%;
        }

        .hero-title {
          font-size: 2.4rem;
          font-weight: bold;
        }
        .hero-subtitle {
          font-size: 2rem;
        }
        .series-copy {
          margin-top: 0.5em;
          padding: 0 2em;
        }

        main {
          padding: 1em;
          max-width: 1280px;
          margin: 0 auto;
        }

        .tilescontainer {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          gap: 16px;
          padding-bottom: 8px;
        }
      </style>
    </main>
  </body>
</html>
