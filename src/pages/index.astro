---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AccordionItem from "../components/AccordionItem.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/FaceTracker.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="title">Andy Zou</h1>

      <div class="face-container">
        <svg viewBox="0 0 640 640" class="circular-labels" aria-hidden="true">
          <defs>
            <!-- Top arc: 9 o'clock → 3 o'clock (through 12) -->
            <path
              id="circle-path-top"
              d="M 30 320 A 290 290 0 0 1 610 320"
              fill="none"></path>
            <!-- Bottom arc: 3 o'clock → 9 o'clock (through 6), opposite direction -->
            <path
              id="circle-path-bottom"
              d="M 30 320 A 290 290 0 0 0 610 320"
              fill="none"></path>
          </defs>
          <!-- NW quadrant -->
          <text class="circle-label">
            <textPath
              href="#circle-path-top"
              startOffset="25%"
              text-anchor="middle">Director</textPath
            >
          </text>
          <!-- NE / top right -->
          <text class="circle-label">
            <textPath
              href="#circle-path-top"
              startOffset="75%"
              text-anchor="middle">Creative</textPath
            >
          </text>
          <!-- SW quadrant -->
          <text class="circle-label">
            <textPath
              href="#circle-path-bottom"
              startOffset="25%"
              text-anchor="middle">Tech Wiz</textPath
            >
          </text>
          <!-- SE quadrant -->
          <text class="circle-label">
            <textPath
              href="#circle-path-bottom"
              startOffset="75%"
              text-anchor="middle">About</textPath
            >
          </text>
        </svg>
        <div
          class="face-tracker"
          id="face"
          data-base-path="/faces/"
          data-debug="true"
        >
        </div>
      </div>

      <AccordionItem title="Director">
        <p class="px-16">
          From pacing to design, Andy’s guiding star when it comes to creative
          is the audience. Making content that resonates beat by beat with
          people is his goal. Whether it’s building on trending tropes or shared
          humanity, Andy strives to find what resonates with people.
        </p>
        <section id="comedy-central" class="case-card flex gap-8 flex-col md:flex-row">
          <div class="flex-1 flex-col justify-end my-auto">
            <h2 class="text-center font-bold">Comedy Central Digital</h2>
            <p class="text-md text-justify">
              As a Social Producer on Comedy Central's Webby-winning digital
              team, Andy spearheaded multiple projects like episodes of <i>Mini-Mocks</i
              >, music videos, and other original content collaborations with
              notable influencers.
            </p>
          </div>
          <img
            src="/public/blog-placeholder-2.jpg"
            alt="Comedy Central Collage"
            class="card-hero flex-1 min-w-0 w-full h-auto"
          />
        </section>
      </AccordionItem>
      <AccordionItem title="Creative">
        <p>
          Andy is a lifelong editor, with a deep understanding of the Adobe
          suite. He can even code in it.
        </p>
      </AccordionItem>
      <AccordionItem title="Technologist">
        <p>
          Andy is a producer, with a deep understanding of the production
          process. He can even code in it.
        </p>
      </AccordionItem>
      <AccordionItem title="Weirdo">
        <p>
          Andy is a VFX artist, with a deep understanding of the VFX process. He
          can even code in it.
        </p>
      </AccordionItem>
      <Footer />
      <script>
        import "../face-tracker.js";
      </script>
    </main>

    <style>
      .title {
        font-size: 10vw;
        margin-bottom: 1rem;
        font-weight: bold;
      }

      main {
        padding: 1em;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      /* Container sizes to SVG; face-tracker is overlaid and centered in the circle */
      .face-container {
        position: relative;
        display: none;
        width: min(70vw, 70vh);
        aspect-ratio: 1;
        container-type: size;
      }

      .circular-labels {
        width: 100%;
        height: auto;
        fill: currentColor;
        display: block;
        position: relative;
        z-index: 10;
      }

      .face-container .face-tracker {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 50%;
        height: 50%;
        border-radius: 50%;
        min-height: 0;
        z-index: 1;
      }

      .circle-label {
        --label-size: 2rem;
        font-size: var(--label-size);
        cursor: default;
        transition: font-size 0.2s ease;
      }
      .circle-label:hover {
        font-size: calc(var(--label-size) * 1.1);
      }
    </style>
  </body>
</html>
