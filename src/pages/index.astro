---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { CASES } from "../data/cases";

const allTags = [...new Set(CASES.flatMap((entry) => entry.tags))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <h1 class="title">Andy Zou</h1>
      <h2>Video Director & Creative Technologist</h2>

      <div class="filters" aria-label="Case filters">
        <fieldset>
          <legend>Filter by tag</legend>
          <div class="tagList">
            {allTags.map((tag) => (
              <label>
                <input type="checkbox" name="tag" value={tag} />
                {tag}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="searchLabel">
          Search
          <input
            id="caseSearch"
            type="search"
            placeholder="Search title, roles, or description"
          />
        </label>
      </div>

      <div id="caseRow" class="caseRow"></div>

      <script
        type="application/json"
        id="__cases"
        set:html={JSON.stringify(CASES)}
      ></script>

      <script type="module">
        const casesEl = document.getElementById("__cases");
        const caseRow = document.getElementById("caseRow");
        const search = document.getElementById("caseSearch");
        const checkboxes = Array.from(document.querySelectorAll('input[name="tag"]'));

        const cases = JSON.parse(casesEl?.textContent || "[]");
        const state = {
          selectedTags: new Set(),
          search: "",
        };

        function includesSearch(caseItem, value) {
          if (!value) return true;
          const haystack = `${caseItem.title} ${caseItem.roles} ${caseItem.copy}`
            .toLowerCase();
          return haystack.includes(value.toLowerCase());
        }

        function intersectsTags(caseItem, selectedTags) {
          if (selectedTags.size === 0) return true;
          return caseItem.tags.some((tag) => selectedTags.has(tag));
        }

        function renderTile(caseItem) {
          const outer = caseItem.href
            ? Object.assign(document.createElement("a"), { href: caseItem.href })
            : document.createElement("article");

          if (outer.tagName === "A") {
            outer.target = "_blank";
            outer.rel = "noopener noreferrer";
            outer.setAttribute("aria-label", `${caseItem.title} on YouTube`);
          }

          outer.className = "tile";
          outer.dataset.id = caseItem.id;

          if (caseItem.media.kind === "image") {
            const img = document.createElement("img");
            img.className = "media";
            img.src = caseItem.media.src;
            img.alt = caseItem.media.alt;
            outer.append(img);
          }

          if (caseItem.media.kind === "video") {
            const video = document.createElement("video");
            video.className = "media";
            video.src = caseItem.media.src;
            video.autoplay = true;
            video.loop = true;
            video.muted = true;
            video.playsInline = true;
            if (caseItem.media.poster) {
              video.poster = caseItem.media.poster;
            }
            outer.append(video);
          }

          if (caseItem.media.kind === "strip") {
            const strip = document.createElement("div");
            strip.className = "strip";

            caseItem.media.sources.forEach((source) => {
              const video = document.createElement("video");
              video.className = "stripItem";
              video.src = source;
              video.autoplay = true;
              video.loop = true;
              video.muted = true;
              video.playsInline = true;
              strip.append(video);
            });

            outer.append(strip);
          }

          const overlay = document.createElement("div");
          overlay.className = "overlay";

          const title = document.createElement("div");
          title.className = "titleText";
          title.textContent = caseItem.title;

          const copy = document.createElement("div");
          copy.className = "copy";
          copy.textContent = caseItem.copy;

          const roles = document.createElement("div");
          roles.className = "roles";
          roles.textContent = caseItem.roles;

          overlay.append(title, roles, copy);
          outer.append(overlay);

          return outer;
        }

        function render() {
          const filtered = cases.filter(
            (caseItem) =>
              intersectsTags(caseItem, state.selectedTags) &&
              includesSearch(caseItem, state.search),
          );

          caseRow.replaceChildren(...filtered.map((caseItem) => renderTile(caseItem)));
        }

        search?.addEventListener("input", (event) => {
          state.search = event.currentTarget.value.trim();
          render();
        });

        checkboxes.forEach((checkbox) => {
          checkbox.addEventListener("change", (event) => {
            const input = event.currentTarget;
            if (input.checked) {
              state.selectedTags.add(input.value);
            } else {
              state.selectedTags.delete(input.value);
            }
            render();
          });
        });

        render();
      </script>
      <Footer />
    </main>

    <style>
      main {
        padding: 1em;
        max-width: 1280px;
        margin: 0 auto;
      }

      .title {
        font-size: clamp(4rem, 10vw, 8rem);
        margin-bottom: 0.5rem;
        font-weight: bold;
      }

      .filters {
        display: grid;
        gap: 12px;
        margin: 24px 0;
      }

      .tagList {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .searchLabel {
        display: grid;
        gap: 6px;
        max-width: 320px;
      }

      .caseRow {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 8px;
      }

      .tile {
        flex: 0 0 320px;
        aspect-ratio: 16 / 9;
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
      }

      .media {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .strip {
        display: flex;
        width: 100%;
        height: 100%;
      }

      .stripItem {
        width: 33.333%;
        height: 100%;
        object-fit: cover;
      }

      .overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: rgba(0, 0, 0, 0.25);
        color: white;
        text-align: center;
        padding: 12px;
        opacity: 0;
        transition: opacity 200ms ease;
      }

      .tile:hover .overlay,
      .tile:focus-within .overlay {
        opacity: 1;
      }

      .titleText {
        font-weight: 700;
      }

      .roles {
        margin-top: 6px;
        font-size: 0.95rem;
      }

      .copy {
        margin-top: 6px;
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
