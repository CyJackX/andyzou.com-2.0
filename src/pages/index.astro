---
import AccordionItem from "../components/AccordionItem.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
import WorkTile from "../components/WorkTile.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getHomeFeed } from "../lib/work";

const homeFeed = getHomeFeed();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class ="text-center">
      <h1 class="title">Andy Zou</h1>
      <h2>Video Director & Creative Technologist</h2>
      <AccordionItem title="Director">
      </AccordionItem>
      <AccordionItem title="Technologist">
      </AccordionItem>
      <AccordionItem title="Weirdo">
      </AccordionItem>
      <AccordionItem title="About">
      </AccordionItem>
      

      <div id="tilescontainer" class="tilescontainer">
        {homeFeed.map((item) => (
          <WorkTile
            id={item.id}
            type={item.type}
            title={item.title}
            subtitle={item.subtitle}
            roles={item.roles}
            copy={item.copy}
            media={item.media}
            href={item.href}
            lightboxable={item.type === "video" && item.href.startsWith("http")}
            vertical={item.vertical === true}
            ariaLabel={`${item.title} details`}
          />
        ))}
      </div>
      <VideoLightbox tileSelector="#tilescontainer .tile[data-lightboxable='true']" />
      <Footer />
    </main>

    <style>
      main {
        padding: 1em;
        max-width: 1280px;
        margin: 0 auto;
      }

      .title {
        font-size: clamp(4rem, 10vw, 8rem);
        margin-bottom: 0.5rem;
        font-weight: bold;
      }

      .tilescontainer {
        display: flex;
        flex-wrap: wrap;
        justify-content:center;
        align-items:center;
        gap: 16px;
        padding-bottom: 8px;
      }
    </style>
  </body>
</html>
