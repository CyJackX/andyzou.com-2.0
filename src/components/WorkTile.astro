---
import type { Media } from "../data/cases";

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  roles: string;
  copy?: string;
  media: Media;
  href: string;
  type?: "video" | "series";
  lightboxable?: boolean;
  vertical?: boolean;
  ariaLabel?: string;
  className?: string;
}

const {
  id,
  title,
  subtitle,
  roles,
  copy,
  media,
  href,
  type = "video",
  lightboxable,
  vertical = false,
  ariaLabel,
  className = "",
} = Astro.props;

const isExternal = /^https?:\/\//i.test(href);
const resolvedLightboxable = lightboxable ?? (type === "video" && isExternal);
---

<a
  class={`tile ${className}`.trim()}
  href={href}
  aria-label={ariaLabel ?? `${title} details`}
  data-id={id}
  data-type={type}
  data-lightboxable={resolvedLightboxable ? "true" : undefined}
  data-vertical={vertical ? "true" : undefined}
>
  {
    media.kind === "image" && (
      <img class="media" src={media.src} alt={media.alt} loading="lazy" />
    )
  }
  {
    media.kind === "video" && (
      <video
        class="media"
        src={media.src}
        autoplay
        loop
        muted
        playsinline
        poster={media.poster}
      />
    )
  }
  {
    media.kind === "strip" && (
      <div class="strip">
        {media.sources.map((source) => (
          <video
            class="stripItem"
            src={source}
            autoplay
            loop
            muted
            playsinline
          />
        ))}
      </div>
    )
  }

  <div class="overlay">
    <div class="titleText">{title}</div>
    {subtitle && <div class="subtitleText">{subtitle}</div>}
    <div class="roles">{roles}</div>
    {copy && copy.trim().length > 0 && <div class="copy">{copy}</div>}
  </div>
</a>

<style>
  .tile {
    flex: 1 0 320px;
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }

  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .strip {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .stripItem {
    width: 33.333%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    text-align: center;
    padding: 1rem;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 1),
      rgba(0, 0, 0, 0.5)
    );
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .tile:hover .overlay,
  .tile:focus-within .overlay,
  .tile:focus-visible .overlay {
    opacity: 1;
  }

  .titleText {
    font-weight: 600;
    font-size: 3rem;
    line-height: 1.2;
  }

  .subtitleText {
    font-weight: 600;
  }
  
  .titleText {
    transform: translateY(-10px);
  }

  .roles,
  .subtitleText,
  .copy {
    transform: translateY(10px);
  }

  .titleText,
  .roles,
  .subtitleText,
  .copy {
    opacity: 0;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .tile:hover .titleText,
  .tile:hover .roles,
  .tile:hover .subtitleText,
  .tile:hover .copy,
  .tile:focus-within .roles,
  .tile:focus-within .subtitleText,
  .tile:focus-within .copy,
  .tile:focus-visible .roles,
  .tile:focus-visible .subtitleText,
  .tile:focus-visible .copy {
    opacity: 1;
    transform: translateY(0);
  }
</style>
