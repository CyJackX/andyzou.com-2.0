---
const marqueeLabel = "Director producer editor creative technologist weirdo";
---

<header class="header">
  <h1 class="bigtitle"><a href="/">Andy Zou</a></h1>
  <!-- <video
    src="/videos/Comp 1.mp4"
    muted
    loop
    autoplay
    playsinline
    class="md:h-[8cqw] w-full md:w-auto header-video"></video> -->
  <a class="marquee" href="/" data-marquee aria-label={marqueeLabel}>
    <div class="marquee__content">
      <div class="marquee__group">
        <h1>Director</h1>
        <h1>Producer</h1>
        <h1>Editor</h1>
        <h1>creative</h1>
        <h1>technologist</h1>
        <h1>weirdo</h1>
      </div>
      <div class="marquee__copies" aria-hidden="true"></div>
    </div>
  </a>
</header>

<script>
  function setMarqueeContents(marquee) {
    const group = marquee.querySelector(".marquee__group");
    const copies = marquee.querySelector(".marquee__copies");

    if (!group || !copies) {
      return;
    }

    const groupWidth = group.getBoundingClientRect().width;

    if (!groupWidth) {
      return;
    }

    const numberOfCopies = Math.ceil(window.innerWidth / groupWidth) + 1;

    marquee.style.setProperty("--trackWidth", `${groupWidth}`);
    copies.replaceChildren();

    for (let index = 0; index < numberOfCopies; index += 1) {
      copies.appendChild(group.cloneNode(true));
    }
  }

  function initMarquees() {
    document.querySelectorAll("[data-marquee]").forEach(setMarqueeContents);
  }

  function handleMarqueeMediaLoad(event) {
    const marquee = event.target.closest("[data-marquee]");

    if (marquee) {
      setMarqueeContents(marquee);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMarquees, { once: true });
  } else {
    initMarquees();
  }

  window.addEventListener("resize", initMarquees);
  document.addEventListener("loadedmetadata", handleMarqueeMediaLoad, true);
  document.addEventListener("loadeddata", handleMarqueeMediaLoad, true);
</script>

<style>
  .header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .subtitle {
    font-size: 3cqw;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: justify;
  }

  .marquee {
    display: flex;
    flex-direction: row;
    width: 100%;
    overflow: hidden;
    font-weight: bold;
    border-top: 0.4rem rgb(var(--gray-light)) solid;
    border-bottom: 0.4rem rgb(var(--gray-light)) solid;
    --trackWidth: 100;
    --animSpeed: 50;
  }

  .marquee__content {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: max-content;
    animation: marquee-scroll calc((var(--trackWidth) * 1s) / var(--animSpeed))
      linear infinite;
  }

  .marquee__group,
  .marquee__copies {
    display: flex;
    flex-direction: row;
    align-items: end;
    flex-shrink: 0;
    gap: 3rem;
    padding-top: 0.1em; /* to center text*/
  }

  .marquee__group > *,
  .marquee__copies > * {
    flex-shrink: 0;
  }

  .marquee__group :is(h1, h2, h3, h4, h5, h6),
  .marquee__copies :is(h1, h2, h3, h4, h5, h6) {
    display: block;
    margin: 0;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .marquee__group video,
  .marquee__copies video {
    height: 4rem;
    width: auto;
    border-radius: 0.3rem;
    object-fit: cover;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(calc(-1px * var(--trackWidth)));
    }
  }
</style>
