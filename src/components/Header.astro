---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header class="text-left">
	<h1 class="bigtitle">Andy Zou</h1>
	<p class="subtitle">
		Director & Creative
		<br />Andy@AndyZou.com
	</p>
</header>
<style>
	header {
		max-width: 1280px;
		margin: 0 auto;
		width: 100%;
		border-bottom: 0.5cqw solid white;
		display:flex;
		justify-content: space-between;
		align-items: end;
	}

	.subtitle {
		font-size: 3cqw;
		line-height: 1.25;
		text-align:right;
	}
</style>
